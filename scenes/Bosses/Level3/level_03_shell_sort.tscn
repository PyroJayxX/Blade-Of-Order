[node name="Cutscene" parent="." unique_id=1237687727 instance=ExtResource("7_swf52")]
layer = 200
visible = false
pages = Array[String](["You awake at the edge of the Shattered Bridge, where the path to the next sector is spread too thin to walk upon. The Shell Boss, an armored titan of interlocking plates, guards the mechanism that bridges these long-range gaps. ", "The titan thrives on distance, keeping the truth far out of reach. You must use the Blade to strike through its heavy shielding and force the distant ends of the world to meet in the middle."])


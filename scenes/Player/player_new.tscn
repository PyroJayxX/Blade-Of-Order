shader = SubResource("Shader_mra3b")
shader_parameter/particles_anim_h_frames = 3
shader_parameter/particles_anim_v_frames = 1
shader_parameter/particles_anim_loop = true
shader_parameter/flash_color = Color(1, 0.6745098, 1, 1)
shader_parameter/flash_speed = 20.0
shader_parameter/flash_intensity = 1.0


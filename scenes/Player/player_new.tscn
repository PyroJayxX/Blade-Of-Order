[sub_resource type="Shader" id="Shader_mra3b"]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform int particles_anim_h_frames;
uniform int particles_anim_v_frames;
uniform bool particles_anim_loop;

uniform vec4 flash_color : source_color = vec4(0.7, 0.0, 1.0, 1.0); // default purple
uniform float flash_speed = 15.0; // higher = faster flash
uniform float flash_intensity : hint_range(0.0, 1.0) = 0.8; // intensity of flash

void vertex() {
	float h_frames = float(particles_anim_h_frames);
	float v_frames = float(particles_anim_v_frames);
	VERTEX.xy /= vec2(h_frames, v_frames);
	float particle_total_frames = float(particles_anim_h_frames * particles_anim_v_frames);
	float particle_frame = floor(INSTANCE_CUSTOM.z * float(particle_total_frames));
	if (!particles_anim_loop) {
		particle_frame = clamp(particle_frame, 0.0, particle_total_frames - 1.0);
	} else {
		particle_frame = mod(particle_frame, particle_total_frames);
	}	
	vec2 scale_uv = UV / vec2(h_frames, v_frames);
	UV = scale_uv + vec2(
		mod(particle_frame, h_frames) / h_frames, 
		floor((particle_frame + 0.5) / h_frames) / v_frames);
}

void fragment() {
	vec4 tex_color = texture(TEXTURE, UV); // get base color of sprite
	
	// combine w particle process mat
	vec4 base_color = tex_color * COLOR;
	
	// create a pulsing value between 0.0 and 1.0 using a sine wave
	// sin() goes from -1 to 1. adding 1.0 and dividing by 2.0 scales it to 0 to 1.
	float pulse = (sin(TIME * flash_speed) + 1.0) / 2.0;
	
	// mix the base color's rgb with the purple color based on the pulse and intensity
	vec3 final_rgb = mix(base_color.rgb, flash_color.rgb, pulse * flash_intensity);
	
	COLOR = vec4(final_rgb, base_color.a);
}"

